# Supabase project credentials for the live draft rooms.
# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings > API). These are public, browser-safe keys.
# Live rooms are optional: without these the local draft board still works.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Riot Games API key for rival scouting (server only, never exposed to the
# browser). Get a development key at https://developer.riotgames.com.
# Scouting is optional: without this the draft and rooms still work.
RIOT_API_KEY=RGAPI-your-development-key
